# ==============================================================================
# ChatSphare Platform — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Mode
# ------------------------------------------------------------------------------
ENVIRONMENT=development               # "development" | "production" | "test"
APP_TITLE=ChatSphare API
APP_VERSION=1.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Connection (PostgreSQL 15 + pgvector via PostgREST)
# ------------------------------------------------------------------------------
SUPABASE_URL=                         # e.g., https://your-project.supabase.co
SUPABASE_ANON_KEY=                    # Public anonymous API key
SUPABASE_SERVICE_ROLE_KEY=           # Secret service_role key for backend DB operations
SUPABASE_JWT_SECRET=                  # Supabase JWT Secret for token decoding

# ------------------------------------------------------------------------------
# 3. CORS & Allowed Frontend Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=False

# ------------------------------------------------------------------------------
# 4. Session Cookie Security Policies
# ------------------------------------------------------------------------------
COOKIE_SECURE=False                   # Set to True in production (HTTPS)
COOKIE_SAME_SITE=lax                  # lax | strict | none
COOKIE_MAX_AGE=2592000                # 30 days in seconds

# ------------------------------------------------------------------------------
# 5. Anti-Bot Security Secret
# ------------------------------------------------------------------------------
CAPTCHA_SECRET_KEY=chatsphare-server-sensitive-captcha-secret-salt-2026

# ------------------------------------------------------------------------------
# 6. Primary LLM Configuration (Mistral AI)
# ------------------------------------------------------------------------------
LLM_PROVIDER=mistral
MISTRAL_API_KEY=                      # Your Mistral AI API Key
MISTRAL_MODEL=mistral-small-latest    # Default model identifier

# ------------------------------------------------------------------------------
# 7. Multi-Provider Fallback AI Keys (Optional but Recommended)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=                       # Google Gemini API Key (Flash / Pro)
GROQ_API_KEY=                         # Groq API Key (Ultra-fast LPU inference)
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=                       # OpenAI API Key (GPT-4o-Mini, GPT-4o)
DEEPSEEK_API_KEY=                     # DeepSeek API Key (Chat V3, Reasoner R1)
OPENROUTER_API_KEY=                   # OpenRouter Unified Gateway Key
OPENROUTER_MODEL=openrouter/auto

# ------------------------------------------------------------------------------
# 8. Firebase Admin Configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=chatsphare-app
FIREBASE_CREDENTIALS_PATH=            # Optional: Path to service-account.json

# ------------------------------------------------------------------------------
# 9. Cloud Infrastructure & AWS (For Production Deployment)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
