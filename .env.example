# ==============================================================================
# ChatSphare Enterprise AI Agent Operating Platform — Root Master .env.example
# Centralized single source of truth for Backend, Frontend, and Tooling.
# NOTE: All secret credentials and keys must be kept blank until explicitly set.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Mode
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_TITLE=ChatSphare API
APP_VERSION=1.0.0
PORT=8000
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Connection (PostgreSQL 15 + pgvector via PostgREST)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# 3. CORS & Allowed Frontend Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=False

# ------------------------------------------------------------------------------
# 4. Session Cookie Security Policies
# ------------------------------------------------------------------------------
COOKIE_SECURE=False
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=2592000

# ------------------------------------------------------------------------------
# 5. Anti-Bot Security Secret (Used for SVG CAPTCHA HMAC tokens & session signing)
# ------------------------------------------------------------------------------
CAPTCHA_SECRET_KEY=chatsphare-server-sensitive-captcha-secret-salt-2026

# ------------------------------------------------------------------------------
# 6. Primary LLM Provider Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 7. Multi-Provider Fallback AI Keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# ------------------------------------------------------------------------------
# 8. Firebase Admin Configuration (Backend)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# ------------------------------------------------------------------------------
# 9. Cloud Infrastructure & AWS (For Production Deployment)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# ------------------------------------------------------------------------------
# 10. Frontend (Vite) Application Settings & Client SDK
# ------------------------------------------------------------------------------
VITE_API_TARGET=http://127.0.0.1:8000
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
